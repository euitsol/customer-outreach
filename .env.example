POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg2://mailcampaign:change_me@db:5432/mailcampaign

# --- panel login (set a strong password; leave empty only for local testing) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_password
# Optional: fixed cookie-signing key (any long random string). Defaults to a derived value.
SECRET_KEY=

# --- sending account ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=marketing@euitsols.com
SMTP_PASSWORD=your_app_password
SENDER_NAME=Your Name
SENDER_EMAIL=marketing@euitsols.com

# IMAP account to watch for replies and bounces (usually same mailbox)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=marketing@euitsols.com
IMAP_PASSWORD=your_app_password

# Public HTTPS domain pointed at this VPS (used in tracking pixel / links / unsubscribe)
TRACK_BASE_URL=https://track.euitsols.com

# Defaults only: after first start these are edited in the panel (Settings page)
MIN_DELAY_SECONDS=25
MAX_DELAY_SECONDS=75
MAX_PER_DAY=80
CHECK_INTERVAL_SECONDS=60
TIMEZONE=Europe/Dublin

# Country for phone numbers typed without +country code (ISO code), and the default deal currency
DEFAULT_PHONE_REGION=IE
DEFAULT_CURRENCY=EUR

# Public base URL of the panel (shown in Integrations / API instructions). Defaults to TRACK_BASE_URL.
PUBLIC_BASE_URL=https://marketing.europeanit.academy

# --- WhatsApp Business (Meta Cloud API). Leave empty to keep WhatsApp off. See Integrations page.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DISPLAY_NUMBER=
# Made-up string you also enter in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=
# Meta app secret: webhook payloads are rejected unless their signature matches
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- MCP server (Claude). Requests must carry an API key created in the panel.
MCP_HOST=0.0.0.0
MCP_PORT=8092
# Optional DNS-rebinding protection: comma separated Host values allowed to reach /mcp
MCP_ALLOWED_HOSTS=
